{
  "name": "fluentra",
  "version": "0.1.0",
  "private": true,
  "description": "Fluentra — multi-tenant restaurant reservation & guest management SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
