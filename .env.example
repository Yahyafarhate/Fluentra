# ---- Database ----
# Runtime connection: must be a NON-superuser role so Row Level Security is enforced.
DATABASE_URL=postgres://fluentra_app:fluentra_app@localhost:5432/fluentra
# Owner/migration connection (creates schema, runs migrations, seeds). Never used by the web runtime.
MIGRATION_DATABASE_URL=postgres://fluentra:fluentra@localhost:5432/fluentra
# Password given to the fluentra_app role by the migration runner.
APP_DB_PASSWORD=fluentra_app

# ---- App ----
APP_URL=http://localhost:3000
# Used to sign short-lived public tokens (min 32 chars). Generate: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me-1234
# Shared secret for POST /api/cron/tick (background jobs). Required in production.
CRON_SECRET=change-me-cron-secret

# ---- Development switches (never enable in production) ----
# When no email/SMS/WhatsApp provider is connected, record messages as clearly-labelled SIMULATED
DEV_SIMULATE_NOTIFICATIONS=true
# Start the in-process job runner (polls every 15s). In production use an external scheduler or `npm run worker`.
JOB_RUNNER_INLINE=true

# ---- Email (SMTP) — optional; enables real email delivery ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fluentra <no-reply@example.com>"

# ---- Provider placeholders (adapters are interfaces only; see docs/INTEGRATIONS.md) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Uploads ----
# Local disk storage for logos/photos in development. Use S3-compatible storage in production.
UPLOAD_DIR=./uploads
