# ---- Database (separate database from Fluentra) ----
# Runtime connection: must be a NON-superuser role so Row Level Security is enforced.
DATABASE_URL=postgres://comptoir_app:comptoir_app@localhost:5432/comptoir
# Owner/migration connection. Never used by the web runtime.
MIGRATION_DATABASE_URL=postgres://fluentra:fluentra@localhost:5432/comptoir
APP_DB_PASSWORD=comptoir_app

APP_URL=http://localhost:3100
# Shared secret for POST /api/cron/tick (outbox delivery). Required in production.
CRON_SECRET=change-me-cron-secret

# ---- Payments ----
# Enables the clearly-labelled TEST card terminal (never enable in production).
POS_ENABLE_TEST_PAYMENTS=true

# ---- Fluentra integration ----
# Shared HMAC secret used to sign events sent to Fluentra (adapter "http"). Never stored in the database.
FLUENTRA_SHARED_SECRET=
TRUST_PROXY=

# Self-service organization creation (POST /api/auth/signup). Disabled in production unless "true".
POS_ALLOW_SIGNUP=
